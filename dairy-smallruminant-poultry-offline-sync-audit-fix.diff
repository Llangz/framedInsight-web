-export default function AddCowPage() {
-  return <AddCowClient />;
+export default async function AddCowPage() {
+  const supabase = await createClient();
+
+  const { data: { user } } = await supabase.auth.getUser();
+  if (!user) {
+    redirect("/auth/login");
+  }
+
+  const { data: farmManager } = await supabase
+    .from("farm_managers")
+    .select("farm_id")
+    .eq("user_id", user.id)
+    .maybeSingle();
+
+  if (!farmManager) {
+    redirect("/onboarding");
+  }
+
+  return <AddCowClient farmId={farmManager.farm_id} />;
 }
